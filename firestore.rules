rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin' && userDoc().data.active == true;
    }
    function isActive() {
      return signedIn() && userDoc().data.active == true;
    }
    function isTeacher() {
      return isActive() && userDoc().data.role == 'teacher';
    }
    function assignedTo(classId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + classId));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Users cannot grant themselves roles or reactivate themselves.
      allow create, update, delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isAdmin() ||
        (isTeacher() && resource.data.classId is string && assignedTo(resource.data.classId)) ||
        (isActive() && userDoc().data.role == 'student' && userDoc().data.studentId == studentId);
      allow create, update, delete: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == teacherId);
      allow create, update, delete: if isAdmin();
    }
    match /classes/{classId} {
      allow read: if isAdmin() || assignedTo(classId);
      allow create, update, delete: if isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if isAdmin() ||
        (signedIn() && assignmentId.matches('.*') && assignmentId.split('_')[0] == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{recordId} {
      allow read: if isAdmin() ||
        (resource.data.classId is string && assignedTo(resource.data.classId)) ||
        (isActive() && userDoc().data.role == 'student' &&
          resource.data.studentId == userDoc().data.studentId);
      allow create, update: if isAdmin() ||
        (request.resource.data.classId is string &&
          assignedTo(request.resource.data.classId) &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.status in ['Present', 'Absent', 'Late', 'Excused'] &&
          request.resource.data.studentId is string &&
          request.resource.data.date is string);
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
